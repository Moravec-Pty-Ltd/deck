#!/usr/bin/env node
// A stand-in for the `claude` CLI in stream-json mode, for deck's e2e tests.
// Keywords in a prompt pick the reply; see e2e/README.md.
import { randomUUID } from 'node:crypto';
import { createInterface } from 'node:readline';

const args = process.argv.slice(2);
if (args.includes('--version')) {
	console.log('0.0.0 (fake claude)');
	process.exit(0);
}

const sessionId = argValue('--resume') ?? randomUUID();
const mcpConfig = argValue('--mcp-config');
let turn = null;

function argValue(flag) {
	const i = args.indexOf(flag);
	return i >= 0 ? args[i + 1] : undefined;
}

function out(event) {
	process.stdout.write(JSON.stringify(event) + '\n');
}

const usage = { input_tokens: 1200, output_tokens: 40, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 };

// `parent` tags the event as a subagent's, the way claude tags them with the
// id of the Agent call that launched it.
function assistant(content, parent = null) {
	out({ type: 'assistant', session_id: sessionId, parent_tool_use_id: parent, message: { id: `msg_${randomUUID()}`, role: 'assistant', model: 'fake', content, usage } });
}

function toolResult(id, content, parent = null) {
	out({ type: 'user', session_id: sessionId, parent_tool_use_id: parent, message: { role: 'user', content: [{ type: 'tool_result', tool_use_id: id, content, is_error: false }] } });
}

function system(subtype, fields) {
	out({ type: 'system', subtype, session_id: sessionId, ...fields });
}

// A background subagent: its call returns a launch receipt at once, it reports
// progress through claude's task events, and its answer lands in
// task_notification a few seconds after the turn has ended.
function backgroundAgent() {
	const agent = `toolu_${randomUUID()}`;
	const task_id = `task_${randomUUID()}`;
	assistant([{ type: 'tool_use', id: agent, name: 'Agent', input: { description: 'Watch the fake build', subagent_type: 'general-purpose', run_in_background: true, prompt: 'Watch it.' } }]);
	system('task_started', { task_id, tool_use_id: agent, task_type: 'local_agent', description: 'Watch the fake build', subagent_type: 'general-purpose', is_backgrounded: true });
	toolResult(agent, 'Async agent launched successfully.');
	system('task_progress', { task_id, description: 'Reading the fake log', usage: { total_tokens: 1500, tool_uses: 1, duration_ms: 1000 } });
	setTimeout(() => {
		assistant([{ type: 'text', text: 'Background agent checking' }], agent);
		system('task_notification', { task_id, status: 'completed', summary: 'Background report: build is green', usage: { total_tokens: 3000, tool_uses: 2, duration_ms: 4000 } });
	}, 4000);
}

function streamText(text) {
	out({ type: 'stream_event', session_id: sessionId, event: { type: 'message_start' } });
	for (const word of text.split(/(?<= )/)) {
		out({ type: 'stream_event', session_id: sessionId, event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text: word } } });
	}
	assistant([{ type: 'text', text }]);
}

function result(started, subtype = 'success', text = '') {
	out({
		type: 'result',
		subtype,
		is_error: subtype !== 'success',
		session_id: sessionId,
		duration_ms: Date.now() - started,
		num_turns: 1,
		total_cost_usd: 0.0123,
		usage,
		result: text
	});
}

// Calls deck's MCP `ask` tool over Streamable HTTP and returns the answer text.
async function mcpAsk(questions) {
	const url = JSON.parse(mcpConfig).mcpServers.deck.url;
	let sid;
	const rpc = async (body) => {
		const res = await fetch(url, {
			method: 'POST',
			headers: {
				'content-type': 'application/json',
				accept: 'application/json, text/event-stream',
				...(sid ? { 'mcp-session-id': sid } : {})
			},
			body: JSON.stringify(body)
		});
		sid ??= res.headers.get('mcp-session-id') ?? undefined;
		const raw = await res.text();
		const data = raw.split('\n').find((l) => l.startsWith('data:'));
		return data ? JSON.parse(data.slice(5)) : raw ? JSON.parse(raw) : null;
	};
	await rpc({ jsonrpc: '2.0', id: 1, method: 'initialize', params: { protocolVersion: '2025-03-26', capabilities: {}, clientInfo: { name: 'fake-claude', version: '0' } } });
	await rpc({ jsonrpc: '2.0', method: 'notifications/initialized' });
	const reply = await rpc({ jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'ask', arguments: { questions } } });
	if (reply?.error || reply?.result?.isError) throw new Error(reply.error?.message ?? 'ask failed');
	return reply.result.content[0].text;
}

async function respond(prompt) {
	const started = Date.now();
	const t = { interrupted: false, wake: () => {} };
	turn = t;
	try {
		if (prompt.includes('[error]')) {
			streamText('Something went wrong (fake error).');
			result(started, 'error_during_execution');
			return;
		}
		if (prompt.includes('[slow]')) {
			out({ type: 'stream_event', session_id: sessionId, event: { type: 'message_start' } });
			// Waits until interrupted; a test stops it with the Interrupt button.
			await new Promise((resolve) => (t.wake = resolve));
			result(started, 'error_during_execution');
			return;
		}
		if (prompt.includes('[hang]')) {
			out({ type: 'stream_event', session_id: sessionId, event: { type: 'message_start' } });
			// Like a claude stuck on a model request: deaf to interrupt and SIGTERM.
			process.on('SIGTERM', () => {});
			await new Promise(() => {});
		}
		if (prompt.includes('[tool]')) {
			const id = `toolu_${randomUUID()}`;
			assistant([{ type: 'tool_use', id, name: 'Bash', input: { command: 'echo fake', description: 'Echo a fake line' } }]);
			toolResult(id, 'fake tool output');
		}
		if (prompt.includes('[agent]')) {
			const agent = `toolu_${randomUUID()}`;
			const step = `toolu_${randomUUID()}`;
			assistant([{ type: 'tool_use', id: agent, name: 'Agent', input: { description: 'Survey the fake repo', subagent_type: 'general-purpose', prompt: 'Look around.' } }]);
			assistant([{ type: 'text', text: 'Subagent looking around' }], agent);
			assistant([{ type: 'tool_use', id: step, name: 'Bash', input: { command: 'ls', description: 'List the fake repo' } }], agent);
			toolResult(step, 'README.md', agent);
			toolResult(agent, 'Subagent report: one file');
		}
		if (prompt.includes('[background]')) backgroundAgent();
		if (prompt.includes('[ask]')) {
			const id = `toolu_${randomUUID()}`;
			const questions = [{ question: 'Which colour?', header: 'Colour', multiSelect: false, options: [{ label: 'Red' }, { label: 'Blue' }] }];
			assistant([{ type: 'tool_use', id, name: 'mcp__deck__ask', input: { questions } }]);
			const answer = await mcpAsk(questions);
			toolResult(id, answer);
			streamText(`You answered: ${answer}`);
			result(started);
			return;
		}
		const bg = prompt.match(/\[background(-agent)?:(\d+)\]/);
		if (bg) {
			// Work that outlives the turn: claude's live task list, then an empty one when it ends.
			const task_id = `task_${randomUUID()}`;
			const ms = Number(bg[2]) * 1000;
			const live = (tasks) => out({ type: 'system', subtype: 'background_tasks_changed', tasks, uuid: randomUUID(), session_id: sessionId });
			if (bg[1]) {
				// A background Agent call: it joins the list before task_started and leaves after task_notification.
				const agent = `toolu_${randomUUID()}`;
				const description = 'Watch the fake build';
				assistant([{ type: 'tool_use', id: agent, name: 'Agent', input: { description, subagent_type: 'general-purpose', run_in_background: true, prompt: 'Watch it.' } }]);
				live([{ task_id, task_type: 'local_agent', subagent_type: 'general-purpose', description }]);
				out({ type: 'system', subtype: 'task_started', session_id: sessionId, task_id, tool_use_id: agent, task_type: 'local_agent', description, subagent_type: 'general-purpose', is_backgrounded: true });
				toolResult(agent, 'Async agent launched successfully.');
				setTimeout(() => {
					out({ type: 'system', subtype: 'task_notification', session_id: sessionId, task_id, tool_use_id: agent, status: 'completed', summary: 'Background report: build is green' });
					live([]);
				}, ms);
			} else {
				live([{ task_id, task_type: 'local_bash', description: 'fake background work' }]);
				setTimeout(() => live([]), ms);
			}
		}
		const files = [...prompt.matchAll(/\[file:([^\]]+)\]/g)].map((m) => m[1]);
		const text = files.length ? `Here are the files: ${files.join(' and ')}` : `Fake reply to: ${prompt.replace(/\[[\w-]+(:\d+)?\]/g, '').trim()}`;
		streamText(text);
		result(started, 'success', text);
	} catch (err) {
		if (!t.interrupted) {
			streamText(`fake harness failed: ${err.message}`);
			result(started, 'error_during_execution');
		}
	} finally {
		if (turn === t) turn = null;
	}
}

function promptText(content) {
	if (typeof content === 'string') return content;
	return (content ?? []).filter((b) => b.type === 'text').map((b) => b.text).join('\n');
}

out({ type: 'system', subtype: 'init', session_id: sessionId, cwd: process.cwd(), model: 'fake', tools: ['Bash'], mcp_servers: [{ name: 'deck', status: 'connected' }] });

// Messages arriving mid-turn queue behind it, like the real CLI.
let queue = Promise.resolve();
createInterface({ input: process.stdin }).on('line', (line) => {
	let msg;
	try {
		msg = JSON.parse(line);
	} catch {
		return;
	}
	if (msg.type === 'control_request') {
		if (msg.request?.subtype === 'interrupt' && turn) {
			turn.interrupted = true;
			turn.wake();
		}
		out({ type: 'control_response', response: { subtype: 'success', request_id: msg.request_id } });
		return;
	}
	if (msg.type === 'user') {
		out({ ...msg, session_id: sessionId });
		queue = queue.then(() => respond(promptText(msg.message?.content)));
	}
});
