# Build the iOS app (with the embedded watch app) and ship it to TestFlight.
# Auth is an App Store Connect API key; all secrets come from the gitignored
# .env (see .env.example).

require "shellwords"

default_platform(:ios)

APP_ID = "tech.moravec.deck".freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    in_house: false
  )
end

def generate_project
  # The .xcodeproj is not committed; XcodeGen builds it from project.yml.
  Dir.chdir("..") { sh("./generate.sh") }
end

platform :ios do
  desc "Archive DeckApp + DeckWatch and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    generate_project

    next_build = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) rescue 0) + 1
    increment_build_number(xcodeproj: "Deck.xcodeproj", build_number: next_build)

    # Let Xcode create/refresh the distribution certs and profiles (for the app
    # and the embedded watch app) using the API key, no signed-in Xcode account
    # required.
    auth = [
      "-allowProvisioningUpdates",
      # mlx-swift-lm builds its model loader with a Swift macro, and Xcode
      # refuses to run an unvalidated macro outside the IDE's trust prompt.
      # Without this the archive stops at "Macro must be enabled before it can
      # be used".
      "-skipMacroValidation",
      "-authenticationKeyPath #{File.expand_path(ENV.fetch("ASC_KEY_PATH")).shellescape}",
      "-authenticationKeyID #{ENV.fetch("ASC_KEY_ID")}",
      "-authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID")}"
    ].join(" ")

    build_app(
      project: "Deck.xcodeproj",
      scheme: "DeckApp",
      configuration: "Release",
      export_method: "app-store",
      xcargs: auth,
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Create the App Store Connect app records if they do not exist yet"
  lane :bootstrap do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    produce(
      app_identifier: APP_ID,
      app_name: "deck",
      language: "en-US",
      skip_itc: false,
      skip_devcenter: false
    )
  end
end
